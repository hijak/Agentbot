# setup.sh generates these paths for the current Linux user; do not use Windows paths.
COMPOSE_PROJECT_NAME=agentbot-podman
AGENTBOT_DATA_ROOT=/home/user/agentbot/data
PODMAN_SOCKET=/run/user/1000/podman/podman.sock
AGENTBOT_PORT=8799
AGENTBOT_WEBHOOK_PORT=8800
AGENTBOT_HTTP_PORT=8080
AGENTBOT_PUBLIC_URL=http://localhost:8080
# For a trusted HTTPS terminator such as Tailscale Serve, set its exact hostname.
AGENTBOT_HTTPS_HOST=https-disabled.invalid
# Optional npm engine packages; pin versions for reproducible deployments.
ENGINES=
