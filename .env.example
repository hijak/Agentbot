# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=agentbot
AGENTBOT_BIND_ADDRESS=127.0.0.1
AGENTBOT_HTTP_PORT=8080
# Leave empty to use http://localhost:${AGENTBOT_HTTP_PORT:-8080}.
AGENTBOT_PUBLIC_URL=
# Leave empty to inherit AGENTBOT_PUBLIC_URL.
AGENTBOT_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set AGENTBOT_PUBLIC_URL to https:// followed by the same hostname.
# Requires AGENTBOT_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
AGENTBOT_HTTPS_HOST=
AGENTBOT_BASE_IMAGE=ghcr.io/milind-soni/agentbot:latest
AGENTBOT_LOCAL_IMAGE=agentbot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
AGENTBOT_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
AGENTBOT_DATA_EXTERNAL=false

# AgentHosting desktop thin client (default on). Set to 0 for local-first Agentbot.
AGENTHOSTING_HOSTED=1
AGENTHOSTING_DASHBOARD_URL=https://dashboard.agenthosting.app
AGENTHOSTING_API_URL=https://api.agenthosting.app

# React Bits Pro — used by `npx shadcn add @reactbits-starter/…` (put real key in .env.local).
REACTBITS_LICENSE_KEY=
